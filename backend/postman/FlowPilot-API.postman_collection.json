  "item": [
    {
      "name": "Customers",
      "item": [
        {
          "name": "01. Create Customer - Valid",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul Sharma\",\n  \"email\": \"{{$randomEmail}}\",\n  \"phone\": \"9876543210\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/customers", "host": ["{{baseUrl}}"], "path": ["api", "customers"]}
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status code is 201 Created', function () { pm.response.to.have.status(201); });",
                "pm.test('Response has customer id', function () { const j = pm.response.json(); pm.expect(j).to.have.property('id'); });",
                "pm.test('Response has correct name', function () { pm.expect(pm.response.json().name).to.eql('Rahul Sharma'); });",
                "pm.test('Response has createdAt', function () { pm.expect(pm.response.json()).to.have.property('createdAt'); });",
                "pm.collectionVariables.set('lastCustomerId', pm.response.json().id);"
              ]
            }
          }]
        },
